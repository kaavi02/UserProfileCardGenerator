<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Profile Card Generator</title>
  <link rel="stylesheet" href="/style.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
</head>
<body>
  <header class="navbar">
    <a href="/" class="brand">
      <div class="brand-icon">P</div>
      <span>ProfileGen</span>
    </a>
    <nav class="nav-links">
      <a href="/" class="nav-link">Create Card</a>
      <a href="/profiles" class="nav-link">All Profiles</a>
    </nav>
  </header>

  <main class="main-container">
    <section class="hero">
      <h1 class="hero-title">User Profile Card Generator</h1>
      <p class="hero-subtitle">Enter your details on the left to see your dynamic profile card render in real time. Save to database or download as an image.</p>
    </section>

    <div class="grid-layout">
      <div class="form-card">
        <form action="/generate" method="POST" id="profileForm">
          <input type="hidden" id="avatarUrlInput" name="avatarUrl" value="">

          <div class="form-group">
            <label for="name" class="form-label">Full Name</label>
            <input type="text" id="name" name="name" class="form-input" placeholder="e.g. Jane Doe" required autocomplete="off">
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email Address (Unique Card Key)</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="e.g. jane@example.com" required autocomplete="off">
            <div class="form-help">Your profile is saved under your email so it stays permanently accessible</div>
          </div>

          <div class="form-group">
            <label for="bio" class="form-label">Bio / Tagline</label>
            <textarea id="bio" name="bio" class="form-textarea" placeholder="A brief description about yourself, passions, or current role" required></textarea>
          </div>

          <div class="form-group">
            <label for="skills" class="form-label">Skills (comma-separated)</label>
            <input type="text" id="skills" name="skills" class="form-input" placeholder="e.g. JavaScript, React, Node.js, UI Design" required autocomplete="off">
            <div class="form-help">Separate each skill with a comma to render badges in real time</div>
          </div>

          <div class="form-group">
            <label for="avatarStyle" class="form-label">Avatar Style</label>
            <div style="display: flex; gap: 0.5rem;">
              <select id="avatarStyle" name="avatarStyle" class="form-select">
                <option value="fun-emoji">Fun Emoji</option>
                <option value="bottts">Robots (Bottts)</option>
                <option value="avataaars">Friendly Avatars</option>
                <option value="lorelei">Artistic (Lorelei)</option>
                <option value="adventurer">Adventurer RPG</option>
                <option value="pixel-art">Pixel Art Characters</option>
                <option value="notionists">Notion Sketch</option>
                <option value="croodles">Hand Doodles</option>
                <option value="micah">Modern Minimalist</option>
                <option value="thumbs">Thumbs Expressions</option>
                <option value="initials">Initials Badge</option>
              </select>
              <button type="button" id="shuffleBtn" class="btn btn-secondary" style="white-space: nowrap; font-size: 0.88rem; padding: 0 1rem;" onclick="shuffleAvatarSeed()">Randomize</button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Social & Web Links</label>
            <div class="social-inputs-grid">
              <input type="text" id="github" name="github" class="form-input" placeholder="GitHub username or link" autocomplete="off">
              <input type="text" id="linkedin" name="linkedin" class="form-input" placeholder="LinkedIn username or link" autocomplete="off">
            </div>
            <div style="margin-top: 0.8rem;">
              <input type="text" id="portfolio" name="portfolio" class="form-input" placeholder="Portfolio or website link" autocomplete="off">
            </div>
          </div>

          <button type="submit" class="btn btn-primary">Save Profile by Email</button>
        </form>
      </div>

      <div class="preview-container">
        <div class="preview-header">
          <div class="preview-badge">
            <span class="pulse-dot"></span>
            <span>Live Dynamic Preview</span>
          </div>
          <button type="button" id="downloadPreviewBtn" class="btn btn-download" style="padding: 0.45rem 0.9rem; font-size: 0.85rem;" onclick="downloadCard('previewCard', 'my-profile-card')">
            Download PNG
          </button>
        </div>

        <div id="previewCard" class="profile-card">
          <div class="card-banner"></div>
          <div class="card-body">
            <div class="avatar-container">
              <img id="previewAvatar" src="https://api.dicebear.com/7.x/fun-emoji/png?seed=avatar&size=256" alt="Avatar Preview" class="card-avatar" crossorigin="anonymous">
            </div>
            
            <h2 id="previewName" class="card-name">Your Name</h2>
            <p id="previewEmailText" style="font-size: 0.84rem; color: #6366f1; margin-bottom: 0.4rem; font-weight: 500; display: none;"></p>
            <p id="previewBio" class="card-bio">Your bio and tagline will dynamically display here as you type.</p>

            <div class="section-label">Skills & Expertise</div>
            <div id="previewSkills" class="skills-wrapper">
              <span class="skill-tag">JavaScript</span>
              <span class="skill-tag">Design</span>
            </div>

            <div class="section-label">Connect</div>
            <div id="previewSocials" class="social-links">
              <span id="previewEmailBtn" class="social-btn" style="display: none;">Email</span>
              <span id="previewGithub" class="social-btn" style="display: none;">GitHub</span>
              <span id="previewLinkedin" class="social-btn" style="display: none;">LinkedIn</span>
              <span id="previewPortfolio" class="social-btn" style="display: none;">Portfolio</span>
            </div>
          </div>
        </div>

        <div class="side-panel">
          <h3 class="side-title">Recent Profiles</h3>
          <div id="recentProfilesList" class="mini-profile-list">
            <% if (recentProfiles && recentProfiles.length > 0) { %>
              <% recentProfiles.forEach(function(item) { %>
                <a href="/profile/<%= item.id %>" class="mini-card" data-profile-id="<%= item.id %>">
                  <img src="<%= item.avatar %>" alt="<%= item.name %>" class="mini-avatar">
                  <div class="mini-info">
                    <h4><%= item.name %></h4>
                    <p><%= item.email || item.bio %></p>
                  </div>
                </a>
              <% }); %>
            <% } %>
          </div>
          <div style="margin-top: 1rem;">
            <a href="/profiles" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.88rem; padding: 0.5rem 1rem;">View All Stored Cards</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="footer">
    <p>User Profile Card Generator &bull; Dynamic real-time preview, server-side processing, and database storage</p>
  </footer>

  <script>
    const nameInput = document.getElementById('name');
    const emailInput = document.getElementById('email');
    const bioInput = document.getElementById('bio');
    const skillsInput = document.getElementById('skills');
    const avatarSelect = document.getElementById('avatarStyle');
    const githubInput = document.getElementById('github');
    const linkedinInput = document.getElementById('linkedin');
    const portfolioInput = document.getElementById('portfolio');
    const avatarUrlInput = document.getElementById('avatarUrlInput');

    const previewName = document.getElementById('previewName');
    const previewEmailText = document.getElementById('previewEmailText');
    const previewBio = document.getElementById('previewBio');
    const previewSkills = document.getElementById('previewSkills');
    const previewAvatar = document.getElementById('previewAvatar');
    const previewEmailBtn = document.getElementById('previewEmailBtn');
    const previewGithub = document.getElementById('previewGithub');
    const previewLinkedin = document.getElementById('previewLinkedin');
    const previewPortfolio = document.getElementById('previewPortfolio');

    let currentCustomSeed = null;

    function formatClientName(text) {
      if (!text) return '';
      return text
        .trim()
        .toLowerCase()
        .split(' ')
        .filter(Boolean)
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
    }

    function shuffleAvatarSeed() {
      currentCustomSeed = 'face_' + Math.random().toString(36).substring(2, 8);
      updateLivePreview();
    }

    function updateLivePreview() {
      const rawName = nameInput.value;
      const emailValue = emailInput.value.trim();
      const formatted = formatClientName(rawName);
      const bioValue = bioInput.value.trim();
      const skillsValue = skillsInput.value.trim();
      const styleValue = avatarSelect.value;
      const githubValue = githubInput.value.trim();
      const linkedinValue = linkedinInput.value.trim();
      const portfolioValue = portfolioInput.value.trim();

      previewName.textContent = formatted || 'Your Name';

      if (emailValue) {
        previewEmailText.textContent = emailValue;
        previewEmailText.style.display = 'block';
        previewEmailBtn.style.display = 'inline-flex';
      } else {
        previewEmailText.style.display = 'none';
        previewEmailBtn.style.display = 'none';
      }

      previewBio.textContent = bioValue || 'Your bio and tagline will dynamically display here as you type.';

      const activeSeed = encodeURIComponent(currentCustomSeed || (formatted || 'avatar').toLowerCase().trim());
      let finalAvatarUrl = '';

      if (styleValue === 'initials') {
        finalAvatarUrl = 'https://ui-avatars.com/api/?name=' + activeSeed + '&background=6366f1&color=ffffff&bold=true&size=256&format=png';
      } else {
        finalAvatarUrl = 'https://api.dicebear.com/7.x/' + styleValue + '/png?seed=' + activeSeed + '&size=256';
      }

      previewAvatar.src = finalAvatarUrl;
      avatarUrlInput.value = finalAvatarUrl;

      previewSkills.innerHTML = '';
      if (skillsValue) {
        const skillArray = skillsValue.split(',').map(s => s.trim()).filter(Boolean);
        if (skillArray.length > 0) {
          skillArray.forEach(skill => {
            const span = document.createElement('span');
            span.className = 'skill-tag';
            span.textContent = skill;
            previewSkills.appendChild(span);
          });
        } else {
          previewSkills.innerHTML = '<span class="skill-tag">Skill Badge</span>';
        }
      } else {
        previewSkills.innerHTML = '<span class="skill-tag">JavaScript</span><span class="skill-tag">Design</span>';
      }

      previewGithub.style.display = githubValue ? 'inline-flex' : 'none';
      previewLinkedin.style.display = linkedinValue ? 'inline-flex' : 'none';
      previewPortfolio.style.display = portfolioValue ? 'inline-flex' : 'none';
    }

    nameInput.addEventListener('input', function() {
      currentCustomSeed = null;
      updateLivePreview();
    });
    emailInput.addEventListener('input', updateLivePreview);
    bioInput.addEventListener('input', updateLivePreview);
    skillsInput.addEventListener('input', updateLivePreview);
    avatarSelect.addEventListener('change', updateLivePreview);
    githubInput.addEventListener('input', updateLivePreview);
    linkedinInput.addEventListener('input', updateLivePreview);
    portfolioInput.addEventListener('input', updateLivePreview);

    updateLivePreview();

    function syncClientStorage() {
      try {
        const localData = JSON.parse(localStorage.getItem('stored_user_profiles') || '[]');
        if (Array.isArray(localData) && localData.length > 0) {
          const container = document.getElementById('recentProfilesList');
          localData.slice(0, 4).forEach(item => {
            const existing = container.querySelector('[data-profile-id="' + item.id + '"]');
            if (!existing) {
              const cardAnchor = document.createElement('a');
              cardAnchor.href = '/profile/' + encodeURIComponent(item.email || item.id);
              cardAnchor.className = 'mini-card';
              cardAnchor.setAttribute('data-profile-id', item.id);
              cardAnchor.innerHTML = '<img src="' + item.avatar + '" alt="' + item.name + '" class="mini-avatar"><div class="mini-info"><h4>' + item.name + '</h4><p>' + (item.email || item.bio) + '</p></div>';
              container.prepend(cardAnchor);
            }
          });
        }
      } catch (e) {
      }
    }
    syncClientStorage();

    function convertImageToBase64(imgElement) {
      return fetch(imgElement.src)
        .then(res => res.blob())
        .then(blob => {
          return new Promise(resolve => {
            const reader = new FileReader();
            reader.onloadend = () => resolve(reader.result);
            reader.readAsDataURL(blob);
          });
        })
        .catch(() => imgElement.src);
    }

    async function downloadCard(elementId, defaultFileName) {
      const cardElement = document.getElementById(elementId);
      const downloadBtn = document.getElementById('downloadPreviewBtn');
      const avatarImg = cardElement.querySelector('.card-avatar');
      const originalText = downloadBtn.innerText;
      const originalSrc = avatarImg ? avatarImg.src : '';

      downloadBtn.innerText = 'Exporting...';

      if (avatarImg && originalSrc) {
        const base64Data = await convertImageToBase64(avatarImg);
        avatarImg.src = base64Data;
      }

      html2canvas(cardElement, {
        useCORS: true,
        allowTaint: true,
        scale: 2,
        backgroundColor: null
      }).then(function(canvas) {
        if (avatarImg && originalSrc) {
          avatarImg.src = originalSrc;
        }
        const imageLink = document.createElement('a');
        imageLink.download = (defaultFileName || 'profile-card') + '.png';
        imageLink.href = canvas.toDataURL('image/png');
        imageLink.click();
        downloadBtn.innerText = originalText;
      }).catch(function() {
        if (avatarImg && originalSrc) {
          avatarImg.src = originalSrc;
        }
        downloadBtn.innerText = originalText;
        alert('Could not download image. Please try again.');
      });
    }
  </script>
</body>
</html>
