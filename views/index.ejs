<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Profile Card Generator</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="navbar">
    <a href="/" class="brand">
      <div class="brand-icon">P</div>
      <span>ProfileGen</span>
    </a>
    <nav class="nav-links">
      <a href="/" class="nav-link">Create Card</a>
      <a href="/profiles" class="nav-link">All Profiles</a>
    </nav>
  </header>

  <main class="main-container">
    <section class="hero">
      <h1 class="hero-title">User Profile Card Generator</h1>
      <p class="hero-subtitle">Enter your personal details to generate and store a dynamic server-rendered profile card with custom avatar.</p>
    </section>

    <div class="grid-layout">
      <div class="form-card">
        <form action="/generate" method="POST">
          <div class="form-group">
            <label for="name" class="form-label">Full Name</label>
            <input type="text" id="name" name="name" class="form-input" placeholder="e.g. Jane Doe" required>
          </div>

          <div class="form-group">
            <label for="bio" class="form-label">Bio / Tagline</label>
            <textarea id="bio" name="bio" class="form-textarea" placeholder="A brief description about yourself, passions, or current role" required></textarea>
          </div>

          <div class="form-group">
            <label for="skills" class="form-label">Skills (comma-separated)</label>
            <input type="text" id="skills" name="skills" class="form-input" placeholder="e.g. JavaScript, React, Node.js, UI Design" required>
            <div class="form-help">Separate each skill with a comma to render badges</div>
          </div>

          <div class="form-group">
            <label for="avatarStyle" class="form-label">Avatar Style</label>
            <select id="avatarStyle" name="avatarStyle" class="form-select">
              <option value="bottts">Robot (Bottts)</option>
              <option value="avataaars">Friendly Avatars</option>
              <option value="lorelei">Artistic (Lorelei)</option>
              <option value="initials">Initials Badge</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Social & Web Links</label>
            <div class="social-inputs-grid">
              <input type="text" id="github" name="github" class="form-input" placeholder="GitHub username or URL">
              <input type="text" id="linkedin" name="linkedin" class="form-input" placeholder="LinkedIn profile URL">
            </div>
            <div style="margin-top: 0.8rem;">
              <input type="text" id="portfolio" name="portfolio" class="form-input" placeholder="Portfolio or website link">
            </div>
          </div>

          <button type="submit" class="btn btn-primary">Generate Profile Card</button>
        </form>
      </div>

      <aside class="side-panel">
        <h2 class="side-title">Recent Profiles</h2>
        <% if (recentProfiles && recentProfiles.length > 0) { %>
          <div class="mini-profile-list">
            <% recentProfiles.forEach(function(item) { %>
              <a href="/profile/<%= item.id %>" class="mini-card">
                <img src="<%= item.avatar %>" alt="<%= item.name %>" class="mini-avatar">
                <div class="mini-info">
                  <h4><%= item.name %></h4>
                  <p><%= item.bio %></p>
                </div>
              </a>
            <% }); %>
          </div>
        <% } else { %>
          <p style="color: #64748b; font-size: 0.9rem;">No profiles created yet. Fill the form to create the first one!</p>
        <% } %>
        <div style="margin-top: 1.5rem;">
          <a href="/profiles" class="btn btn-outline" style="width: 100%; text-align: center;">View All Profiles</a>
        </div>
      </aside>
    </div>
  </main>

  <footer class="footer">
    <p>User Profile Card Generator &bull; Server-side form processing and dynamic rendering</p>
  </footer>
</body>
</html>
